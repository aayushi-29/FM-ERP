# Copy to .env and fill in. Never commit the real .env file.

# PostgreSQL. DATABASE_URL is the connection the running app uses (pooled,
# if your provider offers one — e.g. Neon's "-pooler" host). DIRECT_URL is
# an unpooled connection to the same database, used only by Prisma
# migrations. For plain local Postgres (no pooler), set both to the same
# value.
DATABASE_URL="postgresql://user:password@localhost:5432/fm_erp?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/fm_erp?schema=public"

# App base URL — also used as the allowed origin for CSRF checks on
# state-changing requests (lib/security/origin.ts). Must match exactly
# (scheme + host + port) in every environment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# First Admin account, used once by `npm run prisma:seed`. Remove
# SEED_ADMIN_EMAIL/PASSWORD from your real .env after the first successful
# seed — they're only read that one time.
SEED_ADMIN_EMAIL="admin@foodmonk.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Admin"

# Private file storage (provider TBD, see Decisions #8). Placeholder names only —
# fill in once a provider is selected; never commit real keys.
FILE_STORAGE_BUCKET=""
FILE_STORAGE_ACCESS_KEY=""
FILE_STORAGE_SECRET_KEY=""

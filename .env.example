# Copy to .env and fill in. Never commit the real .env file.

# PostgreSQL connection string (hosting provider: TBD, see Decisions #8)
DATABASE_URL="postgresql://user:password@localhost:5432/fm_erp?schema=public"

# Auth session secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# App base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Private file storage (provider TBD, see Decisions #8). Placeholder names only —
# fill in once a provider is selected; never commit real keys.
FILE_STORAGE_BUCKET=""
FILE_STORAGE_ACCESS_KEY=""
FILE_STORAGE_SECRET_KEY=""

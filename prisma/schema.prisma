// Food Monk ERP — schema v1
//
// Encodes the confirmed decisions (see /docs/decisions.md):
//  #1 four roles, server-enforced          #7 inventory deferred to Phase 2 — records only here
//  #2 multiple users per client org        #9 audit log present from day one
//  #3 versioned formulations + reapproval  #11 n/a (UI theme, not schema)
//  #4 configurable costing, decimal money
//
// This is the MVP surface only (baseline §3 / §7). No stock-movement ledger,
// no purchase orders — those are Phase 2. Nothing here assumes a GST rate or
// invoice-numbering scheme; those fields are configurable, filled in once the
// accountant confirms Decisions #4 and #6.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Most cloud Postgres providers (Neon, Supabase) front the app's own
  // connection with a pgBouncer-style pooler. Prisma migrations need a
  // direct, unpooled connection — DIRECT_URL — or `migrate deploy` fails
  // against a pooled one. Both point at the same database; if your
  // provider doesn't pool (plain local Postgres), set them identically.
  directUrl = env("DIRECT_URL")
}

// ---------- Identity & access ----------

enum Role {
  ADMIN
  PROJECT_LEAD
  NPD_EXECUTIVE
  CLIENT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Decision #2: a CLIENT user belongs to exactly one client organization.
  // PROJECT_LEAD / NPD_EXECUTIVE scope comes from ProjectAssignment instead.
  clientOrgId   String?
  clientOrg     ClientOrganization? @relation(fields: [clientOrgId], references: [id])

  projectsLed       Project[]          @relation("ProjectLead")
  projectAssignments ProjectAssignment[]
  tasksAssigned      Task[]            @relation("TaskAssignee")
  formulationEdits   FormulationVersion[] @relation("FormulationAuthor")
  approvals          Approval[]        @relation("Approver")
  documentsUploaded  Document[]        @relation("DocumentUploader")
  costSheetsPrepared CostSheet[]       @relation("CostSheetAuthor")
  invoicesCreated    Invoice[]         @relation("InvoiceAuthor")
  paymentsRecorded   Payment[]         @relation("PaymentRecorder")
  paymentsVerified   Payment[]         @relation("PaymentVerifier")
  creditNotesIssued  CreditNote[]      @relation("CreditNoteIssuer")
  expensesLogged     ProjectExpense[]  @relation("ExpenseAuthor")
  auditEntries       AuditLog[]        @relation("AuditActor")
  sessions           Session[]

  // "Changed - Working Logic" branch additions.
  notifications                   Notification[]           @relation("NotificationRecipient")
  revisionRequestsFiled           RevisionRequest[]        @relation("RevisionRequester")
  rawMaterialAttachmentsUploaded  RawMaterialAttachment[]   @relation("RawMaterialAttachmentUploader")

  // 29 Oct 2026 additions (Proposal workflow + stock monitoring).
  proposalsAuthored     Proposal[]      @relation("ProposalAuthor")
  proposalsReviewed     Proposal[]      @relation("ProposalReviewer")
  stockMovementsRecorded StockMovement[] @relation("StockMovementRecorder")

  // 29 Oct 2026 (second pass) additions.
  paymentClaimsSubmitted PaymentClaim[] @relation("PaymentClaimSubmitter")
  paymentClaimsResponded PaymentClaim[] @relation("PaymentClaimResponder")

  // 29 Oct 2026 (fourth pass): materials-approval workflow — confirmed with
  // the user. Raw Materials only (not Suppliers); an NPD Executive's
  // submission needs a Project Lead's or Admin's sign-off.
  rawMaterialsCreated  RawMaterial[] @relation("RawMaterialCreatedBy")
  rawMaterialsApproved RawMaterial[] @relation("RawMaterialApprovedBy")

  @@index([clientOrgId])
}

// Decision (28 Oct 2026): email + password for the MVP. DB-backed sessions
// (not stateless JWTs) so an offboarded user's access can be revoked
// immediately by deleting their rows here, per Decision #9. tokenHash never
// stores the raw session token — only its hash, so a DB read alone can't
// forge a session. SSO/OAuth (Google/Microsoft for staff) is a planned
// follow-on, not built now — see docs/decisions.md.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model ClientOrganization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users    User[]
  contacts ClientContact[]
  projects Project[]
}

model ClientContact {
  id            String   @id @default(cuid())
  clientOrgId   String
  clientOrg     ClientOrganization @relation(fields: [clientOrgId], references: [id])
  name          String
  email         String?
  phone         String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([clientOrgId])
}

// Scopes a PROJECT_LEAD or NPD_EXECUTIVE to specific projects — the
// record-level check referenced throughout the baseline (§4), enforced in
// server code on every query, not inferred from role alone.
model ProjectAssignment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  assignedAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
}

// ---------- CRM ----------

enum LeadStatus {
  OPEN
  QUALIFIED
  CONVERTED
  LOST
}

model Lead {
  id          String     @id @default(cuid())
  companyName String
  contactName String
  email       String?
  phone       String?
  status      LeadStatus @default(OPEN)
  notes       String?
  createdAt   DateTime   @default(now())
  convertedToProjectId String?

  // 29 Oct 2026: Proposal workflow — see Proposal model below and
  // docs/decisions.md's "Proposal/Quotation workflow" note.
  proposals   Proposal[]
}

// Confirmed with the user (29 Oct 2026) to be built: "Create Proposal →
// Internal Review → Approval → Send to Client, with a revision loop back
// to Create Proposal" (the user's own words). The baseline's conceptual
// data model (§7) names "Proposal/Quotation" as a CRM entity, but §6.1
// never narrates a distinct approval workflow for it — this is a
// genuinely new addition, not a baseline gap, and is treated as such in
// docs/decisions.md.
//
// There is no Client user account yet at the lead stage (ClientOrganization
// /ClientContact/User for the client are only created on conversion — see
// app/api/leads/[id]/convert/route.ts), so a prospective client can't log
// in to accept or request changes themselves. Exactly like payment
// verification (Admin manually confirms an offline bank acknowledgement),
// "the client accepted" / "the client asked for changes" here means an
// Admin or Project Lead recording that decision after an offline
// conversation/email — not a client-side action. clientDecisionNotes
// captures what the client actually said, for the record.
enum ProposalStatus {
  DRAFT
  INTERNAL_REVIEW
  SENT
  REVISION_REQUESTED
  ACCEPTED
}

model Proposal {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])

  // Each revision loop ("client asked for changes") creates a new Proposal
  // row rather than mutating the sent one, mirroring FormulationVersion's
  // versioning convention (Decision #3) so a sent proposal's exact wording
  // stays on record even after it's superseded.
  versionNumber     Int        @default(1)
  previousVersionId String?
  previousVersion   Proposal?  @relation("ProposalHistory", fields: [previousVersionId], references: [id])
  nextVersions      Proposal[] @relation("ProposalHistory")

  status      ProposalStatus @default(DRAFT)
  title       String
  content     String
  validUntil  DateTime?

  preparedById String
  preparedBy   User   @relation("ProposalAuthor", fields: [preparedById], references: [id])

  // Set when an Admin/Project Lead approves it out of INTERNAL_REVIEW,
  // moving it to SENT.
  reviewedById String?
  reviewedBy   User?   @relation("ProposalReviewer", fields: [reviewedById], references: [id])
  reviewNotes  String?
  sentAt       DateTime?

  // Set when the client's decision (ACCEPTED or REVISION_REQUESTED) is
  // recorded.
  clientDecisionNotes String?
  decidedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([previousVersionId])
}

// ---------- Delivery: projects, tasks, milestones ----------

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  clientOrgId String
  clientOrg   ClientOrganization @relation(fields: [clientOrgId], references: [id])
  leadId      String
  lead        User          @relation("ProjectLead", fields: [leadId], references: [id])
  status      ProjectStatus @default(ACTIVE)
  scope       String?
  targetDate  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Decision #5 (superseded, "Changed - Working Logic" branch): payment
  // milestones are now a fixed 60/25/15 split (see PaymentStage below),
  // not a free-form per-contract split — and the 60% advance specifically
  // gates execution. Null = advance not yet verified = tasks/trials can't
  // be created on this project (lib/projects/execution-gate.ts). Set the
  // moment an ADMIN verifies the Payment on the project's ADVANCE_60
  // invoice (app/api/payments/[id]/verify/route.ts) — never set directly
  // by a client action, since there's no payment gateway: verification is
  // always a human (Admin) confirming an offline/email acknowledgement.
  advancePaymentVerifiedAt DateTime?

  assignments ProjectAssignment[]
  tasks       Task[]
  milestones  Milestone[]
  products    Product[]
  documents   Document[]
  costSheets  CostSheet[]
  invoices    Invoice[]
  expenses    ProjectExpense[]
  activity    ProjectActivity[]
  notifications Notification[]

  @@index([clientOrgId])
  @@index([leadId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id])
  title       String
  description String?
  status      TaskStatus @default(TODO)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  dependsOnId String?
  dependsOn   Task?      @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependents  Task[]     @relation("TaskDependency")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // 29 Oct 2026 (second pass): distinct from createdAt/updatedAt so a
  // client-visible "delivery style" view can show exactly when a task was
  // handed to its current assignee and when it was finished, without that
  // reading being muddled by an unrelated title/description edit touching
  // updatedAt too. assignedAt is set/refreshed every time assigneeId
  // changes (including the first assignment); completedAt is set the
  // moment status transitions to DONE and cleared if it's moved back to
  // any other status (app/api/tasks/[id]/route.ts).
  assignedAt  DateTime?
  completedAt DateTime?

  @@index([projectId])
  @@index([assigneeId])
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

model Milestone {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id])
  title     String
  dueDate   DateTime?
  status    MilestoneStatus @default(PENDING)
  createdAt DateTime        @default(now())

  @@index([projectId])
}

model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  actorId   String
  summary   String
  createdAt DateTime @default(now())

  @@index([projectId])
}

// ---------- NPD: products, formulations, trials ----------

model Product {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  createdAt DateTime @default(now())

  formulations Formulation[]

  @@index([projectId])
}

model Formulation {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  createdAt DateTime @default(now())

  versions FormulationVersion[]

  @@index([productId])
}

// Decision #3: Draft -> In Review -> Approved (or Rejected). An approved
// version is immutable — a later change creates a NEW version row, it never
// edits this one. previousVersionId chains the history.
enum FormulationVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

model FormulationVersion {
  id                 String   @id @default(cuid())
  formulationId      String
  formulation        Formulation @relation(fields: [formulationId], references: [id])
  versionNumber      Int
  status             FormulationVersionStatus @default(DRAFT)
  previousVersionId  String?
  previousVersion    FormulationVersion? @relation("FormulationHistory", fields: [previousVersionId], references: [id])
  nextVersions       FormulationVersion[] @relation("FormulationHistory")
  authorId           String
  author             User     @relation("FormulationAuthor", fields: [authorId], references: [id])
  processNotes       String?
  createdAt          DateTime @default(now())
  submittedAt        DateTime?
  decidedAt          DateTime?

  ingredientLines IngredientLine[]
  trials          Trial[]
  costSheets      CostSheet[]
  approvals       Approval[]
  // "After approval add rework section when client changes their
  // requirements" — a Client can only file a RevisionRequest against an
  // APPROVED version (app/api/formulation-versions/[id]/revision-requests
  // /route.ts); it doesn't mutate this version (still immutable per
  // Decision #3) — NPD/Admin responds with the existing revise flow,
  // optionally linking the new version back here via addressedVersionId.
  revisionRequests         RevisionRequest[] @relation("RevisionRequestForVersion")
  addressedRevisionRequest RevisionRequest?  @relation("RevisionRequestAddressed")

  @@unique([formulationId, versionNumber])
  @@index([formulationId])
}

model IngredientLine {
  id                   String   @id @default(cuid())
  formulationVersionId String
  formulationVersion   FormulationVersion @relation(fields: [formulationVersionId], references: [id])
  materialName         String
  rawMaterialId        String?
  rawMaterial          RawMaterial? @relation(fields: [rawMaterialId], references: [id])
  quantity             Decimal  @db.Decimal(14, 4)
  unit                 String
  percentage           Decimal? @db.Decimal(6, 3)
  technicalNotes       String?

  @@index([formulationVersionId])
}

enum TrialStatus {
  PLANNED
  IN_PROGRESS
  COMPLETE
}

model Trial {
  id                   String   @id @default(cuid())
  formulationVersionId String
  formulationVersion   FormulationVersion @relation(fields: [formulationVersionId], references: [id])
  conductedById        String
  status               TrialStatus @default(PLANNED)
  parameters           String?
  results              String?
  reviewerNotes        String?
  materialLotUsed      String?   // free-text reference only in MVP — full lot ledger is Phase 2
  quantityConsumed     Decimal?  @db.Decimal(14, 4)
  conductedAt           DateTime @default(now())

  attachments TrialAttachment[]

  @@index([formulationVersionId])
}

model TrialAttachment {
  id        String   @id @default(cuid())
  trialId   String
  trial     Trial    @relation(fields: [trialId], references: [id])
  documentId String
  document   Document @relation(fields: [documentId], references: [id])

  @@index([trialId])
}

// Generic approval record — used by formulation versions and milestones.
// Points at the exact record + version approved; never overwritten.
enum ApprovalDecision {
  APPROVED
  REJECTED
}

model Approval {
  id                   String   @id @default(cuid())
  formulationVersionId String?
  formulationVersion   FormulationVersion? @relation(fields: [formulationVersionId], references: [id])
  approverId           String
  approver             User     @relation("Approver", fields: [approverId], references: [id])
  decision             ApprovalDecision
  comment              String?
  decidedAt            DateTime @default(now())

  @@index([formulationVersionId])
}

// ---------- Documents ----------

enum DocumentType {
  CONTRACT
  TECHNICAL_SPEC
  FORMULATION_SUMMARY   // the client-approved view — distinct from the full recipe
  TRIAL_RECORD
  COMMERCIAL
  OTHER
}

enum DocumentVisibility {
  INTERNAL_ONLY
  CLIENT_VISIBLE
}

model Document {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id])
  type       DocumentType
  visibility DocumentVisibility @default(INTERNAL_ONLY)
  uploadedById String
  uploadedBy   User       @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt  DateTime     @default(now())

  versions         DocumentVersion[]
  trialAttachments TrialAttachment[]

  @@index([projectId])
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id])
  versionNumber Int
  storageKey    String   // private object-storage key, never a public URL
  fileName      String
  fileSizeBytes Int
  uploadedAt    DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

// ---------- Commercial: costing, invoicing, payments ----------

// Decision #4: "Ingredient cost × yield/wastage + packaging/processing/
// labour/testing/overhead; estimate vs. actual kept separate." The exact
// arithmetic (how yield% and wastage% combine with ingredient cost) and
// the exact rates are NOT confirmed — Decision #4 is explicitly flagged in
// docs/decisions.md as needing the accountant's sign-off before real
// numbers go live. What's built here is the recording structure: every
// input the formula touches is its own column, so a historical number
// stays explainable, and a recalculation creates a new row rather than
// overwriting one (never lose the number a client already saw).
enum CostPriceBasis {
  ESTIMATE
  SUPPLIER_QUOTE
  ACTUAL
}

model CostSheet {
  id                   String   @id @default(cuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id])
  formulationVersionId String
  formulationVersion   FormulationVersion @relation(fields: [formulationVersionId], references: [id])
  createdById          String
  createdBy            User     @relation("CostSheetAuthor", fields: [createdById], references: [id])
  priceBasis           CostPriceBasis
  // Ingredient cost is entered explicitly here, not auto-derived from
  // RawMaterial pricing — there's no reliable per-unit material price
  // feed in the MVP (Decision #7 defers the inventory/pricing ledger).
  // RawMaterial.defaultCostPerUnit (below) exists only as an optional
  // *suggestion* the UI can total up from the recipe; this field is what's
  // actually recorded, and recording it is what makes it auditable.
  ingredientCost       Decimal  @db.Decimal(14, 2)
  yieldPercent         Decimal  @db.Decimal(6, 3)
  wastagePercent       Decimal  @db.Decimal(6, 3)
  packagingCost        Decimal  @db.Decimal(14, 2)
  processingCost       Decimal  @db.Decimal(14, 2)
  labourCost           Decimal  @db.Decimal(14, 2)
  testingCost          Decimal  @db.Decimal(14, 2)
  overheadCost         Decimal  @db.Decimal(14, 2)
  batchSizeUnits       Decimal  @db.Decimal(14, 4) // units produced per batch — needed to go from cost-per-batch to cost-per-unit
  costPerBatch         Decimal  @db.Decimal(14, 2) // computed server-side from the inputs above, never trusted from the client
  costPerUnit          Decimal  @db.Decimal(14, 4) // = costPerBatch / batchSizeUnits

  // 29 Oct 2026: Cost Intelligence addition — confirmed with the user.
  // markupPercent is an optional user-entered input (markup over
  // costPerUnit); recommendedSellingPrice is computed server-side from it,
  // same pattern as costPerBatch/costPerUnit. This is explicitly a
  // SUGGESTION only: Decision #4 still needs accountant sign-off on the
  // costing formula itself, so nothing reads this field automatically —
  // no invoice or quotation amount is ever derived from it without a human
  // choosing to use it (see lib/costing/compute.ts).
  markupPercent           Decimal? @db.Decimal(6, 3)
  recommendedSellingPrice Decimal? @db.Decimal(14, 4)

  // 29 Oct 2026 (second pass): MRP visibility. recommendedMrp is a separate,
  // Admin-entered final price — NOT derived from costPerUnit/
  // recommendedSellingPrice, since those are a suggestion computed from an
  // unconfirmed formula (Decision #4) while this is the number Admin
  // actually decides to charge. mrpPublishedAt (null = not published) is the
  // single switch an Admin flips to let the client see ONLY this one number;
  // nothing else on CostSheet is ever exposed to a Client — canReadCosting
  // in lib/costing/scope.ts is untouched and still denies Client all direct
  // access to this model. See docs/decisions.md.
  recommendedMrp  Decimal?  @db.Decimal(14, 2)
  mrpPublishedAt  DateTime?

  currency             String   @default("INR")
  notes                String?  // free-text assumptions — e.g. which supplier quote, what's excluded
  supersedesId         String?  // a recalculation creates a new row and points here — never overwrites
  supersedes           CostSheet? @relation("CostSheetHistory", fields: [supersedesId], references: [id])
  supersededBy         CostSheet[] @relation("CostSheetHistory")
  createdAt            DateTime @default(now())

  @@index([projectId])
  @@index([formulationVersionId])
}

model ProjectExpense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  createdById String
  createdBy   User     @relation("ExpenseAuthor", fields: [createdById], references: [id])
  description String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("INR")
  incurredAt  DateTime @default(now())

  @@index([projectId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

// Decision #5, superseded on the "Changed - Working Logic" branch: the
// payment structure is now a fixed 60% advance / 25% after the first
// sample / 15% before final handover, not a free-form per-contract split.
// paymentStage is nullable on Invoice below so an ad-hoc/non-staged
// invoice (e.g. a one-off expense reimbursement) remains representable,
// and so this stays backward-compatible with any invoice created before
// this change. lib/payments/stage.ts is the single place the 60/25/15
// percentages and display labels live.
enum PaymentStage {
  ADVANCE_60
  SECOND_25
  FINAL_15
}

// Decision #5 (original wording, now superseded — see PaymentStage above):
// milestones were contract-specific and configurable; milestoneLabel
// (free text, not a foreign key to the Milestone model) is kept for
// display and for any invoice that isn't one of the three fixed stages.
model Invoice {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  createdById    String
  createdBy      User     @relation("InvoiceAuthor", fields: [createdById], references: [id])
  // Numbering scheme is TBD — Decision #6, accountant to confirm before
  // real invoices are sent. What's enforced today is only the mechanical
  // rule every scheme will need: unique, assigned once, never reused (see
  // lib/invoices/numbering.ts for the placeholder sequence this generates
  // until a real policy is confirmed).
  invoiceNumber  String   @unique
  milestoneLabel String?
  // Null = not one of the fixed stages (e.g. a one-off/ad-hoc invoice).
  // One invoice per stage per project is enforced in code, not the schema
  // (app/api/projects/[id]/invoices/route.ts), since "one ADVANCE_60 per
  // project" isn't expressible as a plain unique constraint without also
  // scoping it to projectId, and a partial/conditional unique index is
  // more schema complexity than this needs right now.
  paymentStage   PaymentStage?
  // Both stored explicitly, never computed by applying a hardcoded GST
  // rate — Decision #6: "tax rules follow the accountant, never
  // hard-coded." subtotal is the sum of this invoice's lines at creation
  // time (recorded, not re-derived later, so an invoice stays explainable
  // even if lines were somehow edited afterward — though in practice
  // lines are also append-only, see InvoiceLine).
  subtotal       Decimal  @db.Decimal(14, 2)
  taxAmount      Decimal  @db.Decimal(14, 2) @default(0)
  amount         Decimal  @db.Decimal(14, 2) // = subtotal + taxAmount, computed server-side
  currency       String   @default("INR")
  dueDate        DateTime?
  status         InvoiceStatus @default(DRAFT)
  createdAt      DateTime @default(now())

  lines    InvoiceLine[]
  payments Payment[]
  creditNotes CreditNote[]
  paymentClaims PaymentClaim[]

  @@index([projectId])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  description String
  amount      Decimal  @db.Decimal(14, 2)

  @@index([invoiceId])
}

model Payment {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  amount          Decimal  @db.Decimal(14, 2)
  method          String?
  reference       String?
  recordedById    String
  recordedBy      User     @relation("PaymentRecorder", fields: [recordedById], references: [id])
  verifiedById    String?  // only Admin may verify (enforced in code) — a recorded-but-unverified payment is still visible, just flagged
  verifiedBy      User?    @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  receivedAt      DateTime @default(now())

  // 29 Oct 2026 (second pass): set when this Payment was created by an
  // Admin Acknowledging a PaymentClaim, rather than recorded from scratch —
  // see PaymentClaim.resultingPaymentId above (the other side of this
  // 1:1). Null for every Payment recorded the original way.
  sourceClaim PaymentClaim?

  @@index([invoiceId])
}

model CreditNote {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  issuedById String
  issuedBy   User     @relation("CreditNoteIssuer", fields: [issuedById], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  reason     String
  issuedAt   DateTime @default(now())

  @@index([invoiceId])
}

// 29 Oct 2026 (second pass): a Client-submitted claim that a payment was
// made, layered on top of the existing Payment model without touching it —
// Payment stays Admin-only and remains the system of record (see
// docs/decisions.md). A claim never changes Invoice.status and never
// creates a Payment by itself; only an Admin's Acknowledge action does
// that, by creating a real Payment from the claimed details (same as if
// Admin had recorded+verified it manually from a bank statement).
enum PaymentClaimStatus {
  PENDING
  ACKNOWLEDGED
  REJECTED
}

model PaymentClaim {
  id                            String              @id @default(cuid())
  invoiceId                     String
  invoice                       Invoice             @relation(fields: [invoiceId], references: [id])
  submittedById                 String
  submittedBy                   User                @relation("PaymentClaimSubmitter", fields: [submittedById], references: [id])
  amount                        Decimal             @db.Decimal(14, 2)
  bankAccountNumber             String
  paymentMode                   String
  acknowledgementOrInvoiceNumber String
  status                        PaymentClaimStatus  @default(PENDING)
  submittedAt                   DateTime            @default(now())
  respondedById                 String?
  respondedBy                   User?               @relation("PaymentClaimResponder", fields: [respondedById], references: [id])
  respondedAt                   DateTime?
  adminNote                     String?
  // Set only when Acknowledge creates the real Payment, so a claim's
  // history stays linkable to the record it produced.
  resultingPaymentId            String?             @unique
  resultingPayment              Payment?            @relation(fields: [resultingPaymentId], references: [id])

  @@index([invoiceId])
}

// ---------- Supplier / material records only (Decision #7 — no ledger yet) ----------

// 29 Oct 2026 (second pass): `contact` (a single free-text field) replaced
// with two explicit fields — Food Monk's staff were putting a person's
// name and a phone number into one box with no consistent separator,
// which made the list unscannable. `name` above already serves as the
// company name, so these two are specifically the *person* to call and
// their number — see docs/decisions.md for the data-migration note on
// existing `contact` values.
model Supplier {
  id                String   @id @default(cuid())
  name              String
  contactPersonName String?
  contactPhone      String?
  createdAt         DateTime @default(now())

  materials RawMaterial[]
}

model RawMaterial {
  id         String   @id @default(cuid())
  name       String
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  defaultUnit String
  // Optional reference price, used only to *suggest* a cost-sheet
  // ingredient-cost total (quantity × this, summed across a recipe's
  // lines) — never applied automatically. No price history is kept here
  // (that's a ledger, deferred with inventory per Decision #7); whoever
  // prepares a CostSheet confirms or overrides the suggestion, and only
  // the confirmed number on the CostSheet itself is the record.
  defaultCostPerUnit Decimal? @db.Decimal(14, 4)

  // 29 Oct 2026: lightweight stock monitoring — confirmed with the user to
  // explicitly supersede Decision #7's "records only, no stock ledger"
  // (see docs/decisions.md). Deliberately NOT the fuller procurement/
  // inventory system the baseline describes as a later phase (§6.6:
  // purchase orders, receipts, reservations, discrepancy handling) — just
  // a running total plus a simple movement log and a reorder-threshold
  // alert, auditable without that larger build. stockOnHand is a
  // denormalized total kept in sync with StockMovement rows inside the
  // same transaction (lib/inventory/stock.ts), not computed on every read.
  stockOnHand      Decimal  @default(0) @db.Decimal(14, 4)
  // Null = no alerting configured for this material.
  reorderThreshold Decimal? @db.Decimal(14, 4)

  // 29 Oct 2026 (fourth pass): materials-approval workflow — confirmed
  // with the user. An NPD Executive can still add a material, but it
  // starts PENDING and can't be picked into a formulation's ingredient
  // lines (app/api/formulation-versions/[id]/ingredient-lines/route.ts)
  // until a Project Lead or Admin approves it. When Admin or Project Lead
  // adds a material directly, the create route sets it APPROVED (and
  // self-attributes the approval) — their own authority is the sign-off,
  // there's nothing to queue. Default APPROVED so this column doesn't
  // retroactively lock out every pre-existing row once the migration runs.
  approvalStatus  MaterialApprovalStatus @default(APPROVED)
  createdById     String?
  createdBy       User?     @relation("RawMaterialCreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?     @relation("RawMaterialApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  ingredientLines IngredientLine[]
  attachments     RawMaterialAttachment[]
  stockMovements  StockMovement[]

  @@index([supplierId])
  @@index([approvalStatus])
}

enum MaterialApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// One row per stock change (a delivery received, consumption recorded,
// wastage, or a manual correction) — quantityDelta is signed: positive
// adds to stockOnHand, negative subtracts. No separate movement "type"
// enum and no link to a purchase order/receipt — that structure is the
// fuller inventory system Decision #7 (original wording) deferred to
// Phase 2; this is intentionally the lighter-weight version.
model StockMovement {
  id            String   @id @default(cuid())
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  quantityDelta Decimal  @db.Decimal(14, 4)
  reason        String?
  recordedById  String
  recordedBy    User     @relation("StockMovementRecorder", fields: [recordedById], references: [id])
  recordedAt    DateTime @default(now())

  @@index([rawMaterialId])
}

// Ingredient Certificate of Analysis, image-only (enforced in the upload
// route, not the schema — see app/api/raw-materials/[id]/attachments
// /route.ts). Deliberately its own small model rather than reusing
// Document: Document.projectId is required and a RawMaterial is a
// company-wide catalog entry, not scoped to one project, so forcing it
// through Document would mean making projectId optional everywhere else
// that depends on it being set — a much bigger, riskier change for what
// is otherwise a simple "attach an image to a record" need.
model RawMaterialAttachment {
  id            String      @id @default(cuid())
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  storageKey    String
  fileName      String
  fileSizeBytes Int
  uploadedById  String
  uploadedBy    User        @relation("RawMaterialAttachmentUploader", fields: [uploadedById], references: [id])
  uploadedAt    DateTime    @default(now())

  @@index([rawMaterialId])
}

// In-app only — no email/SMS infra exists or is being built on this branch.
// "It should show notifications for client and company both" (payment
// events) is satisfied by writing one row per recipient via lib/notifications
// .ts's notify() helper, which resolves "company" to Admins + the project's
// assigned Project Lead/NPD Executive, and "client" to the active CLIENT
// users in the project's ClientOrganization. projectId is optional so a
// notification can still exist if it's ever needed outside a project
// context, but every notification created on this branch sets it.
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  type        String
  message     String
  link        String?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([recipientId, isRead])
  @@index([projectId])
}

// "After approval add rework section when client changes their
// requirements." Filed by a CLIENT against an APPROVED FormulationVersion
// (app/api/formulation-versions/[id]/revision-requests/route.ts). Does not
// mutate that version — approved versions stay immutable per Decision #3.
// NPD/Admin addresses it through the existing revise flow
// (app/api/formulation-versions/[id]/revise/route.ts), which can optionally
// link the new version back here via addressedVersionId, flipping status to
// ADDRESSED in the same transaction.
enum RevisionRequestStatus {
  OPEN
  ADDRESSED
}

model RevisionRequest {
  id                   String                 @id @default(cuid())
  formulationVersionId String
  formulationVersion   FormulationVersion     @relation("RevisionRequestForVersion", fields: [formulationVersionId], references: [id])
  requestedById        String
  requestedBy          User                   @relation("RevisionRequester", fields: [requestedById], references: [id])
  notes                String
  status               RevisionRequestStatus  @default(OPEN)
  addressedVersionId   String?                @unique
  addressedVersion     FormulationVersion?    @relation("RevisionRequestAddressed", fields: [addressedVersionId], references: [id])
  createdAt            DateTime               @default(now())
  addressedAt          DateTime?

  @@index([formulationVersionId])
}

// ---------- Governance ----------

// Append-only by convention: application code must never expose an
// update/delete route for this model (baseline §10).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
}
